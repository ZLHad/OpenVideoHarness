{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ZLHad/OpenVideoHarness/tools/schemas/render.schema.json",
 "title": "How a video was made, <film>.render.json",
 "description": "What bin/vh render writes beside a video and bin/vh patch reads and rewrites (tools/film/render.mjs, tools/film/patch.mjs). The required fields are what bin/vh patch cannot go without. A sidecar from before version 1 has no version key and is the same shape.",
 "type": "object",
 "required": ["page", "fps", "frames", "first_frame", "encoder"],
 "properties": {
  "version": {"type": "integer"},
  "note": {"type": "string"},
  "page": {"type": "string"},
  "kind": {"type": "string"},
  "width": {"type": "number"},
  "height": {"type": "number"},
  "dpr": {"type": "number"},
  "pixels": {"type": "array", "items": {"type": ["number", "null"]}},
  "fps": {"type": ["number", "string"]},
  "frames": {"type": "integer"},
  "span": {"type": "array", "items": {"type": "number"}},
  "first_frame": {"type": "integer"},
  "capture": {"type": "string"},
  "encoder": {"type": "object", "required": ["gop"], "properties": {"codec": {"type": "string"}, "crf": {"type": "number"}, "preset": {"type": "string"}, "gop": {"type": "integer"}, "pix_fmt": {"type": ["string", "null"]}}},
  "alpha": {"type": "boolean"},
  "motion_blur": {"type": "object"},
  "chunks": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}}},
  "reused_chunks": {"type": "integer"},
  "browser": {"type": ["string", "null"]},
  "real_clock": {"type": "boolean"},
  "soft_gl": {"type": "boolean"},
  "seconds": {"type": "number"},
  "shots": {"type": "array", "items": {"type": "object"}},
  "chapters": {"type": "array", "items": {"type": "object"}},
  "files": {"type": "object"},
  "patches": {"type": "array", "items": {"type": "object"}},
  "edit": {"type": "object", "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "resolved": {"type": "string"}}},
  "entries": {"type": "array", "items": {"type": "object"}},
  "runs": {"type": "array", "items": {"type": "object"}}
 }
}
