{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ZLHad/OpenVideoHarness/tools/schemas/output/commands.schema.json",
 "title": "bin/vh commands --json",
 "description": "The command table (tools/commands.json; tools/commands.py). stage only with --stage.",
 "type": "object",
 "required": ["version", "stages", "commands"],
 "properties": {
  "version": {"enum": [1]},
  "stages": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
     "id": {"type": "string"},
     "name": {"type": "string"},
     "note": {"type": "string"}
    }
   }
  },
  "commands": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["name", "summary", "when", "stages", "reads", "writes", "usage"],
    "properties": {
     "name": {"type": "string"},
     "summary": {"type": "string"},
     "when": {"type": "string"},
     "stages": {"type": "array", "items": {"type": "string"}},
     "reads": {"type": "array", "items": {"type": "string"}},
     "writes": {"type": "array", "items": {"type": "string"}},
     "usage": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["synopsis", "text"],
       "properties": {
        "synopsis": {"type": "string"},
        "text": {"type": "array", "items": {"type": "string"}}
       }
      }
     },
     "subcommands": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["name", "summary"],
       "properties": {
        "name": {"type": "string"},
        "summary": {"type": "string"}
       }
      }
     }
    }
   }
  },
  "stage": {"type": "string"}
 }
}
