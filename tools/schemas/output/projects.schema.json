{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ZLHad/OpenVideoHarness/tools/schemas/output/projects.schema.json",
 "title": "bin/vh projects --json",
 "description": "Every project and where it stands (tools/projects.py). A project that cannot be read has error, and null in what could not be read.",
 "type": "object",
 "required": ["version", "tool", "roots", "count", "truncated", "seconds", "assigned", "projects"],
 "properties": {
  "version": {"enum": [1]},
  "tool": {"type": "string"},
  "roots": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["path", "from", "exists"],
    "properties": {
     "path": {"type": "string"},
     "from": {"type": "string"},
     "exists": {"type": "boolean"}
    }
   }
  },
  "count": {"type": "integer"},
  "truncated": {"type": "boolean"},
  "seconds": {"type": "number"},
  "assigned": {"type": "array"},
  "projects": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "name", "title", "path", "type", "effort", "state", "station", "waiting_on", "next_step", "running", "last_activity", "film", "delivered", "same_id_as", "error"],
    "properties": {
     "now": {"$ref": "#/$defs/now"},
     "plan": {"$ref": "#/$defs/plan"},
     "id": {"type": ["string", "null"]},
     "name": {"type": "string"},
     "title": {"type": ["string", "null"]},
     "path": {"type": "string"},
     "type": {"type": ["string", "null"]},
     "effort": {"type": ["string", "null"]},
     "state": {"enum": ["paused", "delivered", "waiting_person", "waiting_agent", "in_progress", "no_record", "not_started", null]},
     "station": {
      "type": ["object", "null"],
      "required": ["id", "name"],
      "properties": {
       "id": {"type": "string"},
       "name": {"type": "string"}
      }
     },
     "waiting_on": {"enum": ["person", "agent", "nobody", "unknown", null]},
     "next_step": {
      "type": ["object", "null"],
      "required": ["who", "do", "commands", "read", "unfilled"],
      "properties": {
       "who": {"enum": ["person", "agent", "nobody", "unknown"]},
       "do": {"type": "string"},
       "commands": {"type": "array", "items": {"type": "string"}},
       "read": {"type": "array", "items": {"type": "string"}},
       "unfilled": {"type": "object"}
      }
     },
     "running": {"type": "array"},
     "last_activity": {
      "type": ["object", "null"],
      "required": ["t", "at", "cmd", "run", "state", "exit"],
      "properties": {
       "t": {"type": ["number", "null"]},
       "at": {"type": ["string", "null"]},
       "cmd": {"type": ["string", "null"]},
       "run": {"type": ["string", "null"]},
       "state": {"type": ["string", "null"]},
       "exit": {"type": ["integer", "null"]}
      }
     },
     "film": {
      "type": ["object", "null"],
      "required": ["path", "size", "mtime", "version", "check", "stale"],
      "properties": {
       "path": {"type": "string"},
       "size": {"type": "integer"},
       "mtime": {"type": "string"},
       "version": {"type": ["string", "null"]},
       "check": {"type": ["string", "null"]},
       "stale": {"type": ["boolean", "null"]}
      }
     },
     "delivered": {"type": ["string", "null"], "description": "the day a delivered film went out (YYYY-MM-DD), else null"},
     "same_id_as": {"type": "array"},
     "error": {},
     "assigned": {"type": "boolean"},
     "assign_error": {"type": "string"}
    }
   }
  }
 },
 "$defs": {
  "words": {"type": "object", "required": ["zh", "en"], "properties": {"zh": {"type": "string"}, "en": {"type": "string"}}},
  "now": {"description": "Where the film stands for the person, in a sentence, and the one thing to do (tools/standing.py): what Studio says too", "type": ["object", "null"], "required": ["code", "who", "you", "tone", "say", "more", "short", "act", "facts"], "properties": {"code": {"enum": ["paused", "revision_ready", "waiting_you", "notes_unheard", "notes_sent", "notes_taken", "running", "working", "delivered", "no_record", "stopped", "agent_open", "agent_outside", "notes_late", "notes_left", "ship_missing", "setup", "needs_key", "idle", "unknown"]}, "who": {"enum": ["person", "agent", "nobody", "unknown"]}, "say": {"$ref": "#/$defs/words"}, "more": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/words"}]}, "short": {"$ref": "#/$defs/words"}, "act": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["open", "tell", "settings", "none"]}, "mod": {"type": ["string", "null"]}, "sub": {"type": ["string", "null"]}, "label": {"$ref": "#/$defs/words"}, "text": {"$ref": "#/$defs/words"}, "confirm": {"type": "boolean"}, "secondary": {"type": "boolean"}, "sure": {"$ref": "#/$defs/words"}, "sure_note": {"$ref": "#/$defs/words"}}}, "facts": {"type": "object", "properties": {"paths": {"type": "array", "items": {"type": "string"}}, "stop": {"type": "string"}, "listening": {"type": "boolean"}, "pending": {"type": "integer"}, "revisions": {"type": "integer"}, "cmd": {"type": ["string", "null"]}, "film": {"type": ["string", "null"]}, "subtitles": {"type": "array", "items": {"type": "string"}}, "version": {"type": ["string", "null"]}, "keys": {"type": "array", "items": {"type": "string"}}, "service": {"type": ["string", "null"]}, "need": {"enum": ["voice", "timing", "music", "image", null]}, "program": {"type": ["string", "null"]}, "outside": {"type": "boolean"}, "unread": {"type": "integer"}, "late": {"type": "integer"}, "live": {"type": "boolean"}}}, "you": {"enum": ["decide", "nudge", "offer", "none"]}, "tone": {"enum": ["you", "busy", "quiet"]}}},
  "plan": {"description": "The film in a line from its BRIEF and its stops", "anyOf": [{"type": "null"}, {"$ref": "#/$defs/words"}]}
 }
}
