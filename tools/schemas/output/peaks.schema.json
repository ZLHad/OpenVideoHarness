{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/ZLHad/OpenVideoHarness/tools/schemas/output/peaks.schema.json",
 "title": "bin/vh peaks <audio | film | project> --json",
 "description": "A waveform, min and max per bin in -1…1, and what it was made of (tools/peaks.py); the same as the record beside the proxies, with state.",
 "type": "object",
 "required": ["version", "tool", "source", "source_ident", "asked", "bins", "rate", "samples", "duration", "peaks", "t", "at", "state"],
 "properties": {
  "version": {"enum": [1]},
  "tool": {"type": "string"},
  "source": {"type": "string"},
  "source_ident": {
   "type": "object",
   "required": ["size", "mtime"],
   "properties": {
    "size": {"type": "integer"},
    "mtime": {"type": "number"}
   }
  },
  "asked": {"type": "integer"},
  "bins": {"type": "integer"},
  "rate": {"type": "integer"},
  "samples": {"type": "integer"},
  "duration": {"type": "number"},
  "peaks": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
  "t": {"type": "number"},
  "at": {"type": "string"},
  "state": {"enum": ["made", "up to date"]}
 }
}
