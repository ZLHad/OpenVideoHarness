{
  "slug": "iso-anatomy",
  "name": { "zh": "等轴解剖", "en": "Iso Anatomy" },
  "family": "explainer",
  "palette": {
    "bg": "#F6F4EF",
    "page": "#EBE8E1",
    "fg": "#18181A",
    "text": "#57575A",
    "accent": "#E4572E",
    "ink": { "hi": "#26262A", "mid": "#707075", "lo": "#9C9CA0", "faint": "#C4C4C7", "dot": "#3A3A3E" },
    "paper": { "top": "#FFFEFC", "shade": ["#D2CFC8", "#DDDAD4", "#E8E6E0", "#F2F1EC"] },
    "steel": { "top": "#F3F4F6", "shade": ["#B4B8BF", "#C6C9CF", "#D7D9DE", "#E6E8EB"], "shine": "#FFFFFF" },
    "rubber": { "top": "#6A6A70", "shade": ["#38383C", "#424247", "#4D4D52", "#58585D"] },
    "halo": "#8A8A80",
    "extra": ["#EBE8E1", "#57575A", "#707075"]
  },
  "fonts": {
    "display": { "family": ["Helvetica Neue", "Avenir Next"], "weight": 500, "tracking": -0.01 },
    "body": { "family": ["Helvetica Neue", "Avenir Next"], "weight": 400 },
    "zh": { "family": ["PingFang SC", "Hiragino Sans GB"], "weight": 400, "tracking": 0.04 },
    "mono": { "family": ["Menlo", "PT Mono", "Monaco"], "weight": 400, "tracking": 0.08 }
  },
  "camera": {
    "projection": "orthographic",
    "elevation_deg": 30,
    "azimuth_deg": [27, 58],
    "note": "azimuth measured from the object's front (0 = straight on); 45 is the classic isometric corner, 30–35 shows more of the long front face"
  },
  "line": { "outline_px": 1.3, "detail_px": 1.0, "lit_px": 2.2, "scales_with_zoom": false },
  "shading": {
    "tones": 4,
    "light_from": "front-left, above",
    "rule": "flat faces: one of four side tones by which way they face, tops lightest; round parts: the same ramp, continuous"
  },
  "ease": {
    "enter": "cubic-bezier(0.32,0.72,0,1)",
    "move": "cubic-bezier(0.37,0,0.63,1)",
    "explode": { "w": 7.5, "zeta": 0.89 },
    "assemble": { "w": 10, "zeta": 1 },
    "settle_text": { "w": 18, "zeta": 1 },
    "stagger_s": 0.035
  },
  "timing": { "enter_frames": 9, "step_every_s": 0.4, "hold_min_s": 0.9 },
  "texture": { "type": "none", "amount": 0 },
  "transitions": ["explode", "assemble", "select-assembly"],
  "type_anim": "rise-from-slot",
  "sound": {
    "bpm": 150,
    "key": "F",
    "mode": "major",
    "palette": ["xylophone", "guitar (muted)", "guitar (harmonics)", "clock"],
    "sfx": ["click", "tick", "air", "whoosh"]
  },
  "video_types": ["01", "03", "06", "02"],
  "study": [
    { "work": "Anatomy (agent skill)", "year": 2026, "by": "Ryan (wheresryan22), MIT" },
    { "work": "anatomy-reveal (agent skill)", "year": 2026, "by": "Ann Nguyen (annnguyentt), MIT" },
    { "work": "On Isometrical Perspective", "year": 1822, "by": "William Farish" },
    { "work": "Exploded-view drawings of machines", "by": "Renaissance engineering notebooks (see STYLE.md)" }
  ]
}
